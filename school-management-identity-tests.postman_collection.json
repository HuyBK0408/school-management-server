{
  "info": {
    "name": "School Management - Identity-style Tests",
    "_postman_id": "a3c8b0f1-3b6a-4c9d-9b83-identity-style",
    "description": "Collection test theo style identity-service, khớp endpoint trong project của bạn (login2/introspect/logout/refresh).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register & Verify (optional)",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/register/student", "host": ["{{baseUrl}}"], "path": ["auth","register","student"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"newPassword\": \"{{password}}\",\n  \"schoolId\": \"{{schoolId}}\",\n  \"studentCode\": \"{{studentCode}}\",\n  \"fullName\": \"Alice Test\"\n}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth","verify-email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{username}}@example.com\",\n  \"code\": \"<DAN-CODE-TU-MAILTRAP>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (identity-style → dùng /auth/login2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('accessToken');",
                  "pm.expect(json).to.have.property('refreshToken');",
                  "",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "pm.environment.set('refreshToken', json.refreshToken);",
                  "",
                  "// ghi log ngắn",
                  "console.log('accessToken set:', (json.accessToken||'').substring(0,24)+'...');",
                  "console.log('refreshToken set:', (json.refreshToken||'').substring(0,24)+'...');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/login2", "host": ["{{baseUrl}}"], "path": ["auth","login2"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Introspect (Bearer {{accessToken}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('active', true);",
                  "pm.expect(json).to.have.property('sub');",
                  "pm.environment.set('subject', json.sub || '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/introspect", "host": ["{{baseUrl}}"], "path": ["auth","introspect"] }
          }
        },
        {
          "name": "Logout (blacklist jti + revoke refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "// clear token ở env (tuỳ thích)",
                  "pm.environment.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "refreshToken", "value": "{{refreshToken}}", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Refresh (rotate refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('accessToken');",
                  "pm.expect(json).to.have.property('refreshToken');",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "pm.environment.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/x-www-form-urlencoded" } ],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "refreshToken", "value": "{{refreshToken}}", "type": "text" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Protected",
      "item": [
        {
          "name": "Admin Ping (needs SYSTEM_ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// tuỳ role user, ở đây kỳ vọng 200 nếu có ROLE_SYSTEM_ADMIN, ngược lại 403",
                  "pm.test(\"Status 200 or 403\", function () { pm.expect([200,403]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/admin/ping", "host": ["{{baseUrl}}"], "path": ["admin","ping"] }
          }
        },
        {
          "name": "Admin Ping (with blacklisted token - expect 401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Request này giả định bạn vừa gọi Logout ở trên, nên accessToken cũ đã bị blacklist.",
                  "// Không làm gì, chỉ gửi lại token cũ nếu bạn muốn test thủ công."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expect 401/403 after logout\", function(){ pm.expect([401,403]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/admin/ping", "host": ["{{baseUrl}}"], "path": ["admin","ping"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "alice" },
    { "key": "password", "value": "Abcd@1234" },
    { "key": "schoolId", "value": "" },
    { "key": "studentCode", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ]
}
